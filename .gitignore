# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ".env*" greift NUR bei Dateien, die mit ".env" beginnen — keys.env & Co. fielen
# sonst durch und lägen mit ihren API-Keys im Repo.
*.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright-cli (explorative Tests)
.playwright-cli/

# Supabase
supabase/.temp/
ressources/books/

# local DB backups
/chaos-forge-backup-*.sql

# local debug screenshots (exploratory testing artifacts)
/*.png

# scratch / agent review output
/CODE_REVIEW_FINDINGS.md

# Claude Code local state
.claude/scheduled_tasks.lock

# large reference material (copyrighted rulebooks) + upload scratch
ressources/monsters/
ressources/upload/

# Kartendruck: druckreife Endergebnisse (~0,5 GB PNG/PDF/ZIP) — jederzeit über
# scripts/spell-cards/ reproduzierbar, gehören nicht in die Git-History.
# Die Bestell-Anleitung wird bewusst mitversioniert.
Kartendruck/*
!Kartendruck/README.md

# Spell-Cards-Pipeline: nur die gerenderten Karten (~1 GB) bleiben lokal.
# cache/ ist BEWUSST versioniert: Die Bilder darin sind per Gemini generiert
# und nicht reproduzierbar — ein Neubau liefert andere Motive, nicht dieselben.
# Gleiches gilt für die Claude-generierten Regeltexte in content.json.
scripts/spell-cards/out/
