NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
GOOGLE_API_KEY=your-google-ai-api-key
VOYAGE_API_KEY=your-voyage-api-key
# Only needed for running scripts/embed-books.ts and /master GM interface:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# 6-digit PIN for the GM interface at /master:
GM_PIN=000000
# Web push (Settings → Notifications). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# Shared secret between the DB webhook (Supabase Vault "push_dispatch_secret") and /api/push/dispatch:
PUSH_WEBHOOK_SECRET=your-random-secret
